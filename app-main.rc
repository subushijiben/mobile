// 主线（mobile.cpp）专用的资源脚本。
// 为什么要跟 Turbo 分开：版本号和产品名不一样，共用一份的话，主线编出来会带着
// 「mobile Turbo / 1.2.1」的版本资源，自安装比版本时跟 Turbo 串在一起，容易出怪事。
//
//   windres app-main.rc -O coff -o app_res.o

#include <winver.h>

1 ICON "app.ico"

1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,2,0,0
 PRODUCTVERSION 1,2,0,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         0x40004L
 FILETYPE       0x1L
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "mobile"
            VALUE "FileDescription",  "mobile"
            VALUE "FileVersion",      "1.2.0.0"
            VALUE "InternalName",     "mobile"
            VALUE "OriginalFilename", "mobile-v1.2.exe"
            VALUE "ProductName",      "mobile"
            VALUE "ProductVersion",   "1.2.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
